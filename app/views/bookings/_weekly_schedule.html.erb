<!-- Weekly Schedule Navigation -->
<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><%= t('user.bookings.schedule.weekly_view') %></h5>
      <div class="btn-group">
        <%= link_to new_booking_path(place_sport_id: place_sport.id, mode: 'single', date: week_dates.first - 7.days),
                    class: 'btn btn-outline-secondary' do %>
          <i class="bi bi-chevron-left"></i> <%= t('user.bookings.schedule.prev_week') %>
        <% end %>
        <button type="button" class="btn btn-outline-primary">
          <%= l(week_dates.first, format: :short) %> - <%= l(week_dates.last, format: :short) %>
        </button>
        <%= link_to new_booking_path(place_sport_id: place_sport.id, mode: 'single', date: week_dates.first + 7.days),
                    class: 'btn btn-outline-secondary' do %>
          <%= t('user.bookings.schedule.next_week') %> <i class="bi bi-chevron-right"></i>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Schedule Table -->
<div class="card">
  <div class="card-body p-0 schedule-table">
    <%= form_with url: bookings_path, method: :post, id: 'single-booking-form', data: { controller: 'booking-schedule' } do |f| %>
      <%= f.hidden_field :place_sport_id, value: place_sport.id %>
      <%= f.hidden_field :mode, value: 'single' %>
      <%= f.hidden_field :date, id: 'selected-date' %>
      <%= f.hidden_field :start_time, id: 'selected-start-time' %>
      <%= f.hidden_field :end_time, id: 'selected-end-time' %>
      <%= f.hidden_field :total_price, id: 'selected-total-price' %>

      <table class="table table-bordered mb-0">
        <thead class="table-light">
          <tr>
            <th style="min-width: 80px;"><%= t('user.bookings.schedule.time') %></th>
            <% week_dates.each do |date| %>
              <th class="text-center">
                <div><%= t('date.abbr_day_names')[date.wday] %></div>
                <div class="text-muted"><%= date.day %>/<%= date.month %></div>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% time_slots.each do |slot| %>
            <tr>
              <td class="text-center align-middle fw-bold">
                <%= slot[:label] %>
              </td>
              <% week_dates.each do |date| %>
                <%
                  bookings_on_date = bookings_by_date[date] || []
                  is_booked = bookings_on_date.any? do |booking|
                    schedule = booking.field_schedule
                    schedule.start_time.strftime('%H:%M') <= slot[:start_time] &&
                    schedule.end_time.strftime('%H:%M') > slot[:start_time]
                  end
                  
                  cell_class = is_booked ? 'time-cell booked' : 'time-cell available'
                %>
                <td class="<%= cell_class %> p-0"
                    data-booking-schedule-target="cell"
                    data-date="<%= date %>"
                    data-start="<%= slot[:start_time] %>"
                    data-end="<%= slot[:end_time] %>"
                    data-available="<%= !is_booked %>"
                    data-action="click->booking-schedule#selectSlot">
                  <% if is_booked %>
                    <i class="bi bi-lock-fill"></i>
                  <% else %>
                    <i class="bi bi-check-circle"></i>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>

      <!-- Booking Summary -->
      <div class="p-3 bg-light border-top" id="booking-summary" style="display: none;">
        <div class="row align-items-center">
          <div class="col-md-8">
            <h6 class="mb-2"><%= t('user.bookings.schedule.selected_slot') %></h6>
            <p class="mb-1">
              <strong><%= t('user.bookings.schedule.date') %>:</strong>
              <span id="summary-date"></span>
            </p>
            <p class="mb-1">
              <strong><%= t('user.bookings.schedule.time') %>:</strong>
              <span id="summary-time"></span>
            </p>
            <p class="mb-0">
              <strong><%= t('user.bookings.schedule.price') %>:</strong>
              <span id="summary-price" class="text-primary fw-bold"></span>
            </p>
          </div>
          <div class="col-md-4 text-end">
            <%= f.submit t('user.bookings.schedule.confirm_booking'), 
                        class: 'btn btn-primary btn-lg w-100',
                        id: 'submit-booking',
                        disabled: true %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Legend -->
<div class="card mt-3">
  <div class="card-body">
    <div class="d-flex gap-4 justify-content-center">
      <div>
        <span class="badge" style="background-color: #d1f4d1; color: #155724;">
          <i class="bi bi-check-circle"></i>
        </span>
        <%= t('user.bookings.schedule.available') %>
      </div>
      <div>
        <span class="badge" style="background-color: #f8d7da; color: #721c24;">
          <i class="bi bi-lock-fill"></i>
        </span>
        <%= t('user.bookings.schedule.booked') %>
      </div>
      <div>
        <span class="badge" style="background-color: #667eea; color: white;">
          <i class="bi bi-star-fill"></i>
        </span>
        <%= t('user.bookings.schedule.selected') %>
      </div>
    </div>
  </div>
</div>
