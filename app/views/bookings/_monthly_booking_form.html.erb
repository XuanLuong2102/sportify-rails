<div class="card">
  <div class="card-body">
    <h5 class="mb-4"><%= t('user.bookings.monthly.title') %></h5>
    
    <%= form_with url: bookings_path, method: :post, id: 'monthly-booking-form', data: { controller: 'monthly-booking' } do |f| %>
      <%= f.hidden_field :place_sport_id, value: place_sport.id %>
      <%= f.hidden_field :mode, value: 'monthly' %>
      <%= f.hidden_field :total_price, id: 'monthly-total-price' %>

      <div class="row g-3">
        <!-- Month/Year Selection -->
        <div class="col-md-6">
          <label class="form-label"><%= t('user.bookings.monthly.month_year') %></label>
          <div class="row g-2">
            <div class="col-8">
              <%= f.select :month, 
                          Date::MONTHNAMES.compact.map.with_index(1) { |m, i| [m, i] },
                          { selected: Date.current.month },
                          class: 'form-select' %>
            </div>
            <div class="col-4">
              <%= f.select :year,
                          (Date.current.year..(Date.current.year + 1)).to_a,
                          { selected: Date.current.year },
                          class: 'form-select' %>
            </div>
          </div>
        </div>

        <!-- Weekday Selection -->
        <div class="col-md-6">
          <label class="form-label"><%= t('user.bookings.monthly.weekdays') %></label>
          <div class="d-flex flex-wrap gap-2">
            <% Date::DAYNAMES.each_with_index do |day, index| %>
              <div class="form-check">
                <%= check_box_tag "booking[weekdays][]", index, false, 
                                  class: 'form-check-input',
                                  id: "weekday_#{index}",
                                  data: { action: 'change->monthly-booking#updateDates' } %>
                <%= label_tag "weekday_#{index}", t("date.abbr_day_names")[index], class: 'form-check-label' %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Time Selection -->
        <div class="col-md-6">
          <label class="form-label"><%= t('user.bookings.monthly.start_time') %></label>
          <%= f.select :start_time,
                      time_slots.map { |s| [s[:label], s[:start_time]] },
                      { include_blank: t('user.bookings.monthly.select_time') },
                      class: 'form-select',
                      data: { action: 'change->monthly-booking#updatePrice' } %>
        </div>

        <div class="col-md-6">
          <label class="form-label"><%= t('user.bookings.monthly.end_time') %></label>
          <%= f.select :end_time,
                      time_slots.map { |s| [s[:label], s[:end_time]] },
                      { include_blank: t('user.bookings.monthly.select_time') },
                      class: 'form-select',
                      data: { action: 'change->monthly-booking#updatePrice' } %>
        </div>
      </div>

      <!-- Hidden field for dates array -->
      <div id="selected-dates-container"></div>

      <!-- Summary Card -->
      <div class="card bg-light mt-4" id="monthly-summary" style="display: none;">
        <div class="card-body">
          <h6 class="mb-3"><%= t('user.bookings.monthly.summary') %></h6>
          
          <div class="row g-3">
            <div class="col-md-4">
              <div class="text-muted small"><%= t('user.bookings.monthly.total_bookings') %></div>
              <div class="fs-4 fw-bold text-primary" id="total-bookings">0</div>
            </div>
            <div class="col-md-4">
              <div class="text-muted small"><%= t('user.bookings.monthly.price_per_booking') %></div>
              <div class="fs-5" id="price-per-booking">-</div>
            </div>
            <div class="col-md-4">
              <div class="text-muted small"><%= t('user.bookings.monthly.total_price') %></div>
              <div class="fs-4 fw-bold text-success" id="total-price">0 ₫</div>
            </div>
          </div>

          <!-- Selected Dates List -->
          <div class="mt-3">
            <div class="text-muted small mb-2"><%= t('user.bookings.monthly.selected_dates') %>:</div>
            <div id="dates-list" class="d-flex flex-wrap gap-1"></div>
          </div>

          <div class="d-grid mt-3">
            <%= f.submit t('user.bookings.monthly.confirm_bookings'),
                        class: 'btn btn-primary btn-lg',
                        id: 'submit-monthly-booking',
                        disabled: true %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Instructions -->
<div class="alert alert-info mt-3">
  <h6><i class="bi bi-info-circle"></i> <%= t('user.bookings.monthly.instructions') %></h6>
  <ol class="mb-0">
    <li><%= t('user.bookings.monthly.step1') %></li>
    <li><%= t('user.bookings.monthly.step2') %></li>
    <li><%= t('user.bookings.monthly.step3') %></li>
    <li><%= t('user.bookings.monthly.step4') %></li>
  </ol>
</div>
