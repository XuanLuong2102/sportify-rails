<div class="col-md-4 col-lg-3 mb-4">
  <div class="card h-100 product-card">
    <!-- Product Image -->
    <% if product.thumbnail.attached? %>
      <%= link_to "#", data: { product_id: product.id } do %>
        <%= image_tag product.thumbnail.variant(:thumbnail_300), 
                      class: 'card-img-top', 
                      alt: product.name,
                      style: 'height: 200px; object-fit: cover;' %>
      <% end %>
    <% else %>
      <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
        <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
      </div>
    <% end %>

    <div class="card-body d-flex flex-column">
      <!-- Product Name -->
      <h6 class="card-title mb-2">
        <%= link_to product.name, "#", class: 'text-decoration-none text-dark' %>
      </h6>

      <!-- Brand -->
      <% if product.product_brand %>
        <p class="text-muted small mb-2">
          <%= product.product_brand.name %>
        </p>
      <% end %>

      <!-- Price -->
      <% if product.product_variants.any? %>
        <% min_price = product.product_variants.minimum(:price_vnd) %>
        <% max_price = product.product_variants.maximum(:price_vnd) %>
        <p class="text-primary fw-bold mb-3">
          <% if min_price == max_price %>
            <%= number_to_currency(min_price, unit: '₫', format: '%n %u') %>
          <% else %>
            <%= number_to_currency(min_price, unit: '₫', format: '%n %u') %> - 
            <%= number_to_currency(max_price, unit: '₫', format: '%n %u') %>
          <% end %>
        </p>
      <% end %>

      <!-- Stock Badge -->
      <% stock = product.product_variants.sum { |v| v.product_stocks.sum(&:stock_quantity) } %>
      <% if stock > 0 %>
        <span class="badge bg-success mb-2">
          <i class="bi bi-check-circle"></i> <%= t('user.orders.in_stock') %>
        </span>
      <% else %>
        <span class="badge bg-danger mb-2">
          <i class="bi bi-x-circle"></i> <%= t('user.orders.out_of_stock') %>
        </span>
      <% end %>

      <!-- Add to Cart - Quick Add (first available variant) -->
      <div class="mt-auto">
        <% if stock > 0 && product.product_variants.any? %>
          <% first_variant = product.product_variants.joins(:product_stocks).where('product_stocks.stock_quantity > 0').first %>
          <% if first_variant %>
            <%= button_to add_item_cart_path(variant_id: first_variant.id, quantity: 1),
                          method: :post,
                          class: 'btn btn-primary w-100 btn-sm',
                          form: { data: { turbo: false } } do %>
              <i class="bi bi-cart-plus"></i> <%= t('user.orders.add_to_cart') %>
            <% end %>
          <% end %>
        <% else %>
          <button class="btn btn-secondary w-100 btn-sm" disabled>
            <%= t('user.orders.out_of_stock') %>
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  .product-card {
    transition: all 0.3s;
    border: 1px solid #dee2e6;
  }
  .product-card:hover {
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transform: translateY(-5px);
  }
</style>
