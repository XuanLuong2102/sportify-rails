<footer class="bg-dark text-white py-4 mt-5">
  <div class="container">
    <div class="row">
      <div class="col-md-6">
        <h5><i class="bi bi-trophy"></i> Sportify</h5>
        <p class="text-muted"><%= t('user.footer.description') %></p>
      </div>
      <div class="col-md-3">
        <h6><%= t('user.footer.quick_links') %></h6>
        <ul class="list-unstyled">
          <li><%= link_to t('user.nav.home'), root_path, class: 'text-white-50' %></li>
          <li><%= link_to t('user.nav.bookings'), bookings_path, class: 'text-white-50' %></li>
          <li><%= link_to t('user.nav.products'), orders_path, class: 'text-white-50' %></li>
        </ul>
      </div>
      <div class="col-md-3">
        <h6><%= t('user.footer.support') %></h6>
        <ul class="list-unstyled">
          <li><a href="#" class="text-white-50"><%= t('user.footer.contact') %></a></li>
          <li><a href="#" class="text-white-50"><%= t('user.footer.faq') %></a></li>
        </ul>
      </div>
    </div>
    <hr class="border-secondary">
    <div class="text-center text-muted">
      <small>&copy; <%= Date.current.year %> Sportify. <%= t('user.footer.rights') %></small>
    </div>
  </div>
</footer>
