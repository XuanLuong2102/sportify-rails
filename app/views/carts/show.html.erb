<% content_for :title, t('user.cart.title') %>

<div class="container py-4">
  <h2 class="mb-4"><i class="bi bi-cart3"></i> <%= t('user.cart.title') %></h2>

  <% if @cart_items.any? %>
    <div class="row">
      <!-- Cart Items -->
      <div class="col-lg-8">
        <div class="card">
          <div class="card-body">
            <% @cart_items.each do |item| %>
              <div class="row align-items-center border-bottom py-3" data-controller="cart-item">
                <!-- Product Image -->
                <div class="col-md-2 text-center">
                  <% if item[:variant].product.thumbnail.attached? %>
                    <%= image_tag item[:variant].product.thumbnail.variant(:thumbnail_100), 
                                  class: 'img-fluid rounded', 
                                  style: 'max-height: 80px;' %>
                  <% else %>
                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                      <i class="bi bi-image text-muted"></i>
                    </div>
                  <% end %>
                </div>

                <!-- Product Info -->
                <div class="col-md-4">
                  <h6 class="mb-1"><%= item[:variant].product.name %></h6>
                  <p class="text-muted small mb-1">
                    <% if item[:variant].product_color %>
                      <span class="badge" style="background-color: <%= item[:variant].product_color.code_rgb %>;">
                        <%= item[:variant].product_color.name %>
                      </span>
                    <% end %>
                    <% if item[:variant].product_size %>
                      <span class="badge bg-secondary"><%= item[:variant].product_size.name %></span>
                    <% end %>
                  </p>
                  <p class="text-primary mb-0">
                    <%= number_to_currency(item[:variant].price_vnd, unit: '₫', format: '%n %u') %>
                  </p>
                </div>

                <!-- Quantity Controls -->
                <div class="col-md-3">
                  <div class="input-group input-group-sm">
                    <%= button_tag type: 'button', class: 'btn btn-outline-secondary',
                                   data: { action: 'click->cart-item#decrease', variant_id: item[:variant].id } do %>
                      <i class="bi bi-dash"></i>
                    <% end %>
                    
                    <input type="number" 
                           class="form-control text-center" 
                           value="<%= item[:quantity] %>"
                           min="1"
                           data-cart-item-target="quantity"
                           data-variant-id="<%= item[:variant].id %>">
                    
                    <%= button_tag type: 'button', class: 'btn btn-outline-secondary',
                                   data: { action: 'click->cart-item#increase', variant_id: item[:variant].id } do %>
                      <i class="bi bi-plus"></i>
                    <% end %>
                  </div>
                </div>

                <!-- Subtotal & Remove -->
                <div class="col-md-2 text-end">
                  <p class="fw-bold mb-2">
                    <%= number_to_currency(item[:subtotal], unit: '₫', format: '%n %u') %>
                  </p>
                  <%= button_to remove_item_cart_path(variant_id: item[:variant].id),
                                method: :delete,
                                class: 'btn btn-sm btn-outline-danger',
                                data: { turbo_confirm: t('user.cart.confirm_remove') } do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%= link_to orders_path, class: 'btn btn-outline-secondary mt-3' do %>
          <i class="bi bi-arrow-left"></i> <%= t('user.cart.continue_shopping') %>
        <% end %>
      </div>

      <!-- Order Summary -->
      <div class="col-lg-4">
        <div class="card sticky-top" style="top: 20px;">
          <div class="card-header">
            <h5 class="mb-0"><%= t('user.cart.order_summary') %></h5>
          </div>
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
              <span><%= t('user.cart.subtotal') %></span>
              <span class="fw-bold">
                <%= number_to_currency(@cart_total, unit: '₫', format: '%n %u') %>
              </span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span><%= t('user.cart.shipping') %></span>
              <span class="fw-bold">30,000 ₫</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-3">
              <span class="fs-5"><%= t('user.cart.total') %></span>
              <span class="fs-5 fw-bold text-primary">
                <%= number_to_currency(@cart_total + 30000, unit: '₫', format: '%n %u') %>
              </span>
            </div>

            <% if user_signed_in? %>
              <%= render 'checkout_form' %>
            <% else %>
              <div class="alert alert-info">
                <%= t('user.cart.login_to_checkout') %>
              </div>
              <%= link_to t('user.nav.login'), new_user_session_path, 
                          class: 'btn btn-primary w-100 mb-2' %>
              <%= link_to t('user.nav.register'), new_user_registration_path, 
                          class: 'btn btn-outline-primary w-100' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-5">
      <i class="bi bi-cart-x text-muted" style="font-size: 5rem;"></i>
      <h3 class="mt-3"><%= t('user.cart.cart_empty') %></h3>
      <p class="text-muted"><%= t('user.cart.cart_empty_message') %></p>
      <%= link_to t('user.cart.start_shopping'), orders_path, class: 'btn btn-primary mt-3' %>
    </div>
  <% end %>
</div>
