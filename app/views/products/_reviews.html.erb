<div class="row mb-5">
  <div class="col-12">
    <div class="mb-4">
      <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4">
        <h5 class="mb-0 fw-bold"><%= t('user.products.reviews', default: 'Đánh giá từ khách hàng') %></h5>
        <div>
          <span class="fs-4 fw-bold text-warning"><%= average_rating %></span> 
          <span class="text-warning"><i class="bi bi-star-fill"></i></span>
          <span class="text-muted small">/ 5 (<%= total_reviews %> reviews)</span>
        </div>
      </div>
      
      <% if reviews.any? %>
        <% reviews.each do |review| %>
          <div class="review-item border-bottom pb-3 mb-3">
            <div class="d-flex justify-content-between mb-2">
              <div>
                <strong><%= review.user&.username || 'Anonymous' %></strong>
                <div class="text-warning small">
                  <% 5.times do |i| %>
                    <% if i < review.rating %>
                      <i class="bi bi-star-fill"></i>
                    <% else %>
                      <i class="bi bi-star"></i>
                    <% end %>
                  <% end %>
                </div>
              </div>
              <small class="text-muted"><%= time_ago_in_words(review.created_at) %> ago</small>
            </div>
            <p class="mb-0 text-secondary"><%= review.comment %></p>
          </div>
        <% end %>
      <% else %>
        <p class="text-center text-muted my-4">
          <%= t('user.products.no_reviews', default: 'Chưa có đánh giá nào cho sản phẩm này.') %>
        </p>
      <% end %>
    </div>
  </div>
</div>
